rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn()
        && userEmail() == get(/databases/$(database)/documents/config/app).data.adminEmail.lower();
    }
    function isAllowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowlist/$(userEmail()));
    }

    match /config/{doc} {
      allow read: if isAllowed() || isAdmin();
      allow write: if false;
    }

    match /allowlist/{email} {
      allow read: if signedIn() && (userEmail() == email || isAdmin());
      allow write: if isAdmin();
    }

    match /accessRequests/{email} {
      allow create: if request.resource.id == request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.size() <= 254
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'reason', 'uid', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'name', 'reason', 'status'])
        && (request.auth == null
            || (request.auth.token.email != null
                && request.resource.data.email == request.auth.token.email.lower()))
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if signedIn() && (userEmail() == email || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /sessions/{id} {
      allow create: if isAllowed()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'tool', 'start', 'lastBeat', 'activeSeconds'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'tool', 'start', 'lastBeat', 'activeSeconds'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.tool is string
        && request.resource.data.activeSeconds == 0
        && request.resource.data.start == request.time
        && request.resource.data.lastBeat == request.time;
      allow update: if isAllowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSeconds', 'lastBeat'])
        && request.resource.data.lastBeat == request.time
        && request.resource.data.activeSeconds - resource.data.activeSeconds >= 0
        && request.resource.data.activeSeconds - resource.data.activeSeconds <= 120
        && request.resource.data.activeSeconds - resource.data.activeSeconds
           <= (request.time.toMillis() - resource.data.lastBeat.toMillis()) / 1000 + 5;
      allow read: if isAdmin();
    }

    match /logins/{id} {
      allow create: if isAllowed()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.at == request.time;
      allow update, delete: if false;
      allow read: if isAdmin();
    }
  }
}
