rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn()
        && userEmail() == get(/databases/$(database)/documents/config/app).data.adminEmail;
    }
    function isAllowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowlist/$(userEmail()));
    }

    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /allowlist/{email} {
      allow read: if signedIn() && (userEmail() == email || isAdmin());
      allow write: if isAdmin();
    }

    match /accessRequests/{email} {
      allow create: if request.resource.id == request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.size() <= 254
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['email', 'name', 'reason', 'uid', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'name', 'reason', 'status'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if signedIn() && (userEmail() == email || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /sessions/{id} {
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAllowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.activeSeconds >= resource.data.activeSeconds
        && request.resource.data.activeSeconds - resource.data.activeSeconds <= 120;
      allow read: if isAdmin();
    }

    match /logins/{id} {
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAllowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
